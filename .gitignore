# =====================================================
# 重要：避免敏感資料 / Token 上傳到 GitHub
# =====================================================

# === ⚠️ 絕對不要上傳：個人真實資料 ===
imports/                          # 你的歷史匯入資料（業主名、金額）
freelance-backup-*.json           # 任何 JSON 備份檔
backup/                           # 備份資料夾
*-private.*                       # 個人化的檔案
local-data/                       # 任何個人資料

# === ⚠️ 絕對不要上傳：含 Token 的檔案 ===
.env
.env.local
.env.*.local
config.local.*
secrets.*
credentials.*
apps-script-deployed.gs           # 若你把含真實 Token 的 .gs 存回本地

# === 系統 ===
.DS_Store
Thumbs.db
desktop.ini

# === 編輯器 ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Node (若未來加入打包工具) ===
node_modules/
dist/
.env
package-lock.json

# === 日誌 ===
*.log
npm-debug.log*

# === 暫存 ===
*.tmp
*.cache
